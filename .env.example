# Copy to .env and adjust.

# ── Database ────────────────────────────────────────────────────────────────
# Postgres (event day):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mplbe
# SQLite (quick local dev, no Postgres needed):
# DATABASE_URL=sqlite+aiosqlite:///./mpl.db

ADMIN_PASSCODE=admin123

# ── Event clock ─────────────────────────────────────────────────────────────
EVENT_DURATION_SECONDS=7200

# ── Judge backend ───────────────────────────────────────────────────────────
# "mock"    -> executes code locally, NO Docker needed. Development only.
# "judge0"  -> your self-hosted Judge0 CE. USE THIS ON EVENT DAY.
JUDGE_BACKEND=mock

# Only used when JUDGE_BACKEND=judge0
JUDGE0_URL=http://localhost:2358
JUDGE0_AUTH_TOKEN=change-me
JUDGE0_TIMEOUT_SECONDS=30
JUDGE0_POLL_INTERVAL=0.4

# DEV ONLY. Lets the mock judge really run python so you can build without
# Docker. Set to false (or switch to judge0) before the event.
MOCK_EXECUTE_PYTHON=true

# ── Guardrails ──────────────────────────────────────────────────────────────
DEFAULT_CPU_TIME_LIMIT=5
DEFAULT_WALL_TIME_LIMIT=10
DEFAULT_MEMORY_LIMIT_KB=256000
MAX_SOURCE_BYTES=64000

# Protects the judge queue between submits. It is NOT an attempt limit -
# attempts are unlimited.
SUBMIT_COOLDOWN_SECONDS=5
